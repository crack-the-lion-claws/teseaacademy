{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Learner profile stored in Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "learningPath": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Subscription payment transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "plan": { "type": "string" },
        "cycle": { "type": "string" },
        "amount": { "type": "string" },
        "currency": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "accountNumber": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "SchoolInquiry": {
      "title": "School Inquiry",
      "description": "Institutional inquiry request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolName": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles indexed by UID"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Payment transactions"
    },
    "/school_inquiries/{inquiryId}": {
      "schema": "SchoolInquiry",
      "description": "School contact inquiries"
    },
    "/learning_contents/{contentId}": {
      "schema": "LearningContent",
      "description": "Educational lessons and course materials"
    },
    "/learning_sessions/{sessionId}": {
      "schema": "LearningSession",
      "description": "Student learning and practice engagement sessions"
    },
    "/activity_logs/{activityId}": {
      "schema": "ActivityLog",
      "description": "Real-time learning and content activity logs"
    },
    "/assessments/{assessmentId}": {
      "schema": "Assessment",
      "description": "Student assessment submissions and review queue"
    }
  }
}

{
  "version": "1.0.0",
  "basePath": "/api/v1",
  "principles": {
    "authentication": "Bearer access token + rotating refresh session",
    "authorization": "Server-side RBAC plus school/subject/class/resource scope",
    "idempotency": "Required for payments, bulk imports, campaign sends and webhook processing",
    "pagination": "cursor based",
    "errors": {"shape": {"code":"string","message":"string","details":"object?","requestId":"string?"}},
    "audit": "All privileged writes emit immutable audit events"
  },
